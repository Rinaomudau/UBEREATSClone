<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UberEATSClone.Views.CartPage"
    Title="Your Cart">

    <Grid Padding="20">

        <VerticalStackLayout Spacing="15">

            <Label
                Text="🛒 Your Cart"
                FontSize="30"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="CartCollectionView"
                SelectionMode="None"
                VerticalOptions="FillAndExpand">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="10"
                            Margin="0,5"
                            StrokeShape="RoundRectangle 15">

                            <Grid
                                ColumnDefinitions="100,*,Auto"
                                RowDefinitions="Auto,Auto,Auto">

                                <Image
                                    Grid.RowSpan="3"
                                    Source="{Binding ImageUrl}"
                                    HeightRequest="90"
                                    WidthRequest="90"
                                    Aspect="AspectFill" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    FontSize="17"
                                    FontAttributes="Bold" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Price, StringFormat='R{0:F2}'}"
                                    FontSize="15" />

                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Spacing="10">

                                    <Button
                                        Text="-"
                                        WidthRequest="40"
                                        Clicked="DecreaseQuantity_Clicked"
                                        CommandParameter="{Binding}" />

                                    <Label
                                        Text="{Binding Quantity}"
                                        VerticalOptions="Center"
                                        FontSize="16" />

                                    <Button
                                        Text="+"
                                        WidthRequest="40"
                                        Clicked="IncreaseQuantity_Clicked"
                                        CommandParameter="{Binding}" />

                                </HorizontalStackLayout>

                                <Button
                                    Grid.Column="2"
                                    Text="Remove"
                                    FontSize="12"
                                    Clicked="RemoveItem_Clicked"
                                    CommandParameter="{Binding}" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <BoxView
                HeightRequest="1" />

            <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto,Auto">

                <Label
                    Text="Subtotal"
                    FontSize="17" />

                <Label
                    x:Name="SubtotalLabel"
                    Grid.Column="1"
                    FontSize="17" />

                <Label
                    Grid.Row="1"
                    Text="Delivery"
                    FontSize="17" />

                <Label
                    x:Name="DeliveryLabel"
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="R15.00"
                    FontSize="17" />

                <Label
                    Grid.Row="2"
                    Text="Total"
                    FontSize="22"
                    FontAttributes="Bold" />

                <Label
                    x:Name="TotalLabel"
                    Grid.Row="2"
                    Grid.Column="1"
                    FontSize="22"
                    FontAttributes="Bold" />

            </Grid>

            <Button
                Text="Proceed to Checkout"
                BackgroundColor="#00A86B"
                TextColor="White"
                FontSize="18"
                FontAttributes="Bold"
                HeightRequest="55"
                CornerRadius="12"
                Clicked="Checkout_Clicked" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>