<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UberEATSClone.Views.CoverPage"
             BackgroundColor="#06C167">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Padding="30">
        <Label Text="Uber Eats" 
               FontSize="40" 
               FontAttributes="Bold" 
               TextColor="White" 
               HorizontalTextAlignment="Center"/>

        <Label Text="Order food and groceries from your favorite stores." 
               FontSize="16" 
               TextColor="White" 
               HorizontalTextAlignment="Center"/>

        <Button Text="Get Started" 
                Clicked="Button_Clicked" 
                BackgroundColor="White" 
                TextColor="Black" 
                FontAttributes="Bold" 
                CornerRadius="25" 
                HeightRequest="50" 
                WidthRequest="200" 
                Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>