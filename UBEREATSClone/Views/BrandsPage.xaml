<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UberEATSClone.Views.BrandsPage"
             Title="Uber Eats • Stores"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">
            <Label Text="Featured Partners" FontSize="22" FontAttributes="Bold" TextColor="Black"/>

            <CollectionView x:Name="BrandsCollectionView" SelectionMode="Single" SelectionChanged="BrandsCollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12" 
                                Padding="0" 
                                Margin="0,0,0,15" 
                                HeightRequest="160" 
                                BackgroundColor="White"
                                StrokeThickness="0">

                            <Border.Shadow>
                                <Shadow Brush="#33000000" Offset="0,2" Radius="6" Opacity="0.2" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*" RowDefinitions="*, Auto">
                                <Image Grid.Row="0" Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                <VerticalStackLayout Grid.Row="1" Padding="12" BackgroundColor="White" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" TextColor="Black"/>
                                    <Label Text="{Binding DeliveryTime}" FontSize="13" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>